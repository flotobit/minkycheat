{"manifest_version": 3,
 "name": "Minky Cheat Extension",
 "version": "1.1",
 "description": "Cheat panel for minky.figma.site (content script + popup injector)",
 "permissions": ["scripting", "activeTab"],
 "host_permissions": ["https://minky.figma.site/*"],
 "action": { "default_popup": "popup.html" },
 "content_scripts": [
 {
 "matches": ["https://minky.figma.site/*"],
 "js": ["content.js"]
 }
 ]
}